@{
    ViewData["Title"] = "Начало";
}

<div class="text-center py-5">
    <h1 class="display-4">rentApart</h1>
    <p class="lead">Платформа за продажба и отдаване под наем на имоти.</p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary me-2">Регистрация</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Вход</a>
    }
</div>
